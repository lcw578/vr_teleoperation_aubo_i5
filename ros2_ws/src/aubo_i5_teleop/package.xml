<?xml version="1.0"?>
<package format="3">
  <name>aubo_i5_teleop</name>
  <version>0.1.0</version>
  <description>AUBO i5 Route B simulation teleoperation: Quest, local tool rotation, RG/AG95, position tracking and rich recording.</description>
  <maintainer email="lcw@todo.todo">lcw</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>aubo_description</exec_depend>
  <exec_depend>dh_ag95_description</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>aubo_moveit_config</exec_depend>
  <exec_depend>mujoco_ros2_control</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
