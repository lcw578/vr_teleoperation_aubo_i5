<mujoco model="aubo_i5_ros2">
  <!--
    ROS 2 / mujoco_ros2_control 用的场景包装层。
    只做四件事，不动 scene_aubo_i5.xml 里的运动学与惯性：
      1. <option integrator="implicitfast"/> —— 位置执行器较硬，官方 demo 用这个积分器
      2. <contact><exclude> —— 与 SRDF 的 disable_collisions 对齐，见下
      3. <actuator> —— 6 个 position 执行器，映射到 ros2_control 的 position 命令接口
      4. <keyframe> —— 定义一个确定的起始位姿（对应 initial_keyframe 参数）
    执行器形态抄自官方 demo：
      mujoco_ros2_control_demos/demo_resources/robot/test_robot.xml
  -->
  <include file="scene_aubo_i5_rg.xml"/>

  <!-- ============ 场景层 ============
       原来这份只有机器人本体（从 URDF 转换而来的产物里没有场景），
       所以 MuJoCo 里看到的是一片黑、机械臂悬空、没有空间参照。
       下面这几段照抄官方 demo 的 scene.xml：
         mujoco_ros2_control_demos/demo_resources/scenes/scene.xml
       作用分别是：给个天空背景、铺一块带网格线的地面、加方向光、设定初始视角。
  -->
  <statistic center="0 0 0.35" extent="1.2"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="8 8" reflectance="0.1"/>
  </asset>

  <worldbody>
    <!-- 方向光；否则纯靠 headlight，模型没有立体感 -->
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <!--
      地面。放在 z=0（机器人基座所在平面）。
      contype=1/conaffinity=0 与官方 demo 一致：机械臂会与地面碰撞，
      这样工作空间的下边界是真实的，符合"从第一天就按真机标准限定工作空间"。
    -->
    <!-- ⚠️ 2026-09-24：地板从 z=0 降到 z=-1.2。
         为什么：机械臂**基座就在世界原点**，而真机的基座装在升降平台上、地面在下方
         约 1.0–1.6 m（论文：果实离地 1100–1500 mm，基座需在果实高度 ±501 mm 内
         → 基座离地约 1000–1600 mm）。原来地板贴在基座平面上，于是按任务区
         （相对基座垂直偏移 ±501 mm）生成的位姿有一半在地板以下，控制器会把臂
         往地里开——实测那一轮：碰撞降速 1596 次、碰撞急停 24 次、关节到界 9800 次、
         |关节速度| 峰值 7.13 rad/s（远超手册上限 2.618/3.142）。
         -1.2 取 1000–1600 mm 的中值；换值只影响工作区相对地面的高度。
         注意：armB 实验变体（scene_*_armB.xml）是冻结的实验产物，保留旧地板。 -->
    <geom name="floor" type="plane" size="0 0 0.05" pos="0 0 -1.2"
          material="groundplane" contype="1" conaffinity="0"/>

    <!-- ⚠️ 2026-09-24 补上「托住基座的结构」。
         问题：基座是**焊死在世界原点**的（worldbody 里只有它的两个 geom、没有关节），
         而地板已降到 z=-1.2（对应真机基座装在升降平台上）——于是机械臂**悬空 1.2 m**，
         中间什么都没有（ncon=0）。物理上不会掉（焊死的基座是刚性的，不影响动力学，
         测量数字也不受影响），但场景不真实、看起来也不对。**这是改地板时的遗漏。**

         尺寸来源：
           · 底盘 1.30×0.84×0.49 m —— 论文 Xu et al., J. Field Robotics 2026 的 Table 4
             （"Mobile chassis Size (m) 1.30 × 0.84 × 0.49"）
           · 基座离地 1.2 m —— 与地板高度一致（论文：基座需在果实高度 ±501 mm 内，
             果实离地 1100–1500 mm → 基座约 1000–1600 mm；1.2 取中值）
           · 升降平台柱截面 0.25×0.25 m —— 基座安装面是 Ø172 mm（手册 "Footprint: Ø172 mm"），
             0.25 给它留了余量
         立柱顶端止于 z=-0.005（比基座底面低 5 mm）：必须有这个小间隙，否则基座网格
         与立柱重叠会形成**永久接触**。

         ⚠️ 2026-09-25 已解决此前记录的不一致：底盘与立柱**也已加进 MoveIt 的 planning
         scene**（add_scene_floor.py 同步发布三个物体，全尺寸=这里的半尺寸×2）。
         改这里的尺寸/位置时必须同步改 add_scene_floor.py 的 OBJECTS 表。 -->
    <geom name="chassis" type="box" size="0.65 0.42 0.245" pos="0 0 -0.955"
          rgba="0.25 0.25 0.28 1" contype="1" conaffinity="0"/>
    <geom name="platform_column" type="box" size="0.125 0.125 0.3525" pos="0 0 -0.3575"
          rgba="0.45 0.45 0.48 1" contype="1" conaffinity="0"/>
  </worldbody>

  <!-- timestep="0.001"（1 kHz，原为 MuJoCo 默认 2 ms）：更细的步长减少数值阻尼带来的误差
       ——实测同一组执行器参数下，2 ms 与 1 ms 给出的速度增益差约 15%（2 ms 偏小）。
       计算代价可忽略（2 kHz 物理仍有 51 倍实时余量）。
       注：2026-09-24 曾把执行器 kp 大幅提高以凑"速度增益=1"，那组值会让整栈起不来，
       已否决并回退（原因见 actuators_position.xml 顶部）。 -->
  <option integrator="implicitfast" timestep="0.001"/>

  <contact>
    <!--
      来源：aubo_ros2_driver/aubo_moveit_config/config/aubo_i5.srdf 的 12 条 disable_collisions。
      URDF 的碰撞网格本来就会在相邻连杆的关节处互相重叠，ROS/MoveIt 靠 SRDF 排除，
      MuJoCo 不知道这件事——不排除的话基座和 shoulder_Link 会持续互相顶（实测重叠 6.5 mm，
      产生 4 个接触点，把虚假接触力注进物理）。
      这里排除后，MuJoCo 的自碰撞判断与 MoveIt Servo 用的 SRDF 一致，两边不会打架。
      SRDF 里的 ee_link 本模型没有，故略去相关 3 条。
      本模型的基座是挂在 world 上的 geom（转换产物），所以基座那两条写成 world。
    -->
    <exclude body1="world"         body2="shoulder_Link"/>   <!-- SRDF: base_link <-> shoulder_Link  Adjacent -->
    <exclude body1="world"         body2="upperArm_Link"/>   <!-- SRDF: base_link <-> upperArm_Link  Never -->
    <exclude body1="shoulder_Link" body2="upperArm_Link"/>   <!-- Adjacent -->
    <exclude body1="shoulder_Link" body2="wrist1_Link"/>     <!-- Never -->
    <exclude body1="upperArm_Link" body2="foreArm_Link"/>    <!-- Adjacent -->
    <exclude body1="foreArm_Link"  body2="wrist1_Link"/>     <!-- Adjacent -->
    <exclude body1="wrist1_Link"   body2="wrist2_Link"/>     <!-- Adjacent -->
    <exclude body1="wrist1_Link"   body2="wrist3_Link"/>     <!-- Never -->
    <exclude body1="wrist2_Link"   body2="wrist3_Link"/>     <!-- Adjacent -->

    <!-- --- 以下是 rg 齿条夹爪内部（来源整机模型的 6 条 exclude）---
         相邻连杆在关节/滑轨处必然重叠，不排除会持续产生虚假接触力。 -->
    <exclude body1="rg_base" body2="rg_gear"/>
    <exclude body1="rg_base" body2="rg_right_finger"/>
    <exclude body1="rg_base" body2="rg_left_finger"/>
    <exclude body1="rg_gear" body2="rg_right_finger"/>
    <exclude body1="rg_gear" body2="rg_left_finger"/>
    <exclude body1="rg_right_finger" body2="rg_left_finger"/>
    <!-- 夹爪与手腕：rg_base 装在 wrist3_Link 法兰面下方 51 mm（整机模型同值），
         相对位姿全固定，检查无意义。与 AG95 版处理一致。 -->
    <exclude body1="wrist3_Link" body2="rg_base"/>
    <exclude body1="wrist3_Link" body2="rg_gear"/>
    <exclude body1="wrist3_Link" body2="rg_right_finger"/>
    <exclude body1="wrist3_Link" body2="rg_left_finger"/>
  </contact>


  <!-- ============ rg 夹爪的物理耦合 ============
       URDF 表达不了四连杆闭环（解析时会断链，实测 MuJoCo 只解析出 6 个自由度），
       所以闭环必须在 MJCF 里用 equality 补回来。手法照抄 Manipulator-Mujoco 的 ag95.xml，
       而且可以直接抄锚点数值——因为两边手指链的 frame 逐字相同（已核对）。

       - <connect>：把 finger 与 inner_knuckle 在它们的共同铰点钉住，闭合四连杆
       - <joint>：左右两侧外节同步（polycoef="0 1 0 0 0" 即 left = right）
       - <tendon>：把左右外节合成一个驱动量（各 0.5），于是整只手只需 1 个命令
  -->

  <equality>
    <!-- rg 夹爪的齿轮-齿条耦合（来源整机模型）：指节滑移 = polycoef × 齿轮角。
         负号 = 齿轮正转时指节回缩（闭合）。系数即齿轮节圆半径 21 mm 的弧长换算。 -->
    <joint name="rg_couple_right" joint1="rg_right_finger_joint" joint2="rg_gear_joint"
           polycoef="0 -0.02099500 0 0 0" solref="0.004 1" solimp="0.9995 0.9999 0.000001"/>
    <joint name="rg_couple_left" joint1="rg_left_finger_joint" joint2="rg_gear_joint"
           polycoef="0 -0.02099900 0 0 0" solref="0.004 1" solimp="0.9995 0.9999 0.000001"/>
  </equality>

    <include file="actuators_position_rg.xml"/>

  <keyframe>
    <!-- ready：臂 Q_REST（= go_ready 的 READY）+ 夹爪张开端点。
         qpos 必须写满 nq=9（6 臂 + 齿轮铰链 + 左右指滑轨），
         ctrl 写满 nu=7（6 臂 + rg_gear_joint）；两版本 MuJoCo 都要求写满。
         指节滑移按耦合式 polycoef×齿轮角 预置，启动时不产生约束冲量。
         生成器：tools/build_rg_gripper_scene.py -->
    <key name="ready"
         qpos="-1.137355 0.041596 1.593368 -1.589821 -1.137355 2.940000 -0.474409 0.009960 0.009962"
         qvel="0 0 0 0 0 0 0 0 0"
         ctrl="-1.137355 0.041596 1.593368 -1.589821 -1.137355 2.940000 -0.474409"/>
  </keyframe>
</mujoco>
